@model List<Category>
@{
    ViewData["Title"] = Localizer["Categories"].Value;
    Layout = "_AdminLayout";
}

@if (TempData["ErrorMessage"] != null) {
    <div class="admin-alert-error">
        @TempData["ErrorMessage"]
    </div>
}

<div class="admin-page-header">
    <h1>@Localizer["Categories"]</h1>
    <a asp-controller="AdminCategories" asp-action="Create" class="btn-admin-primary">
        + @Localizer["AddCategory"]
    </a>
</div>

<table class="admin-table">
    <thead>
        <tr>
            <th>@Localizer["Icon"]</th>
            <th>@Localizer["ProductName"]</th>
            <th>@Localizer["OnHomepage"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model) {
            <tr>
                <td style="font-size: 22px;">@category.Icon</td>
                <td>@category.GetName()</td>
                <td>@(category.IsFeatured? Localizer["Yes"].Value : "—")</td>
                <td class="admin-table-actions">
                    <a asp-controller="AdminCategories" asp-action="Edit" asp-route-id="@category.Id">
                        ✏️
                    </a>
                    <form asp-controller="AdminCategories" asp-action="Delete" asp-route-id="@category.Id" method="post"
                          onsubmit="return confirm('@Localizer["ConfirmDeleteCategory", category.Name]')" class="delete-form">
                        <button type="submit">🗑</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>