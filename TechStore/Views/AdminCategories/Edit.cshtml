@model CategoryFormViewModel
@{
    ViewData["Title"] = "Редактировать категорию";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <h1>Редактировать категорию</h1>
</div>

<div class="admin-form-box">
    <form asp-controller="AdminCategories" asp-action="Edit" asp-route-id="@ViewBag.CategoryId" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <partial name="_CategoryFormFields" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn-admin-primary">Сохранить изменения</button>
            <a asp-controller="AdminCategories" asp-action="Index" class="btn-admin-secondary">Отмена</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}