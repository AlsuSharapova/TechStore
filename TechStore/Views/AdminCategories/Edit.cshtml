@model CategoryFormViewModel
@{
    ViewData["Title"] = Localizer["EditCategory"].Value;
    Layout = "_AdminLayout";
}

<div class="admin-page-header details-page-header">
    <h1>@Localizer["EditCategory"]</h1>
</div>

<div class="admin-form-box">
    <form asp-controller="AdminCategories" asp-action="Edit" asp-route-id="@ViewBag.CategoryId" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <partial name="_CategoryFormFields" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn-admin-primary">@Localizer["SaveChanges"]</button>
            <a asp-controller="AdminCategories" asp-action="Index" class="btn-admin-secondary">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}