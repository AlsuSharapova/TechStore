@model ProductsIndexViewModel
@{
    ViewData["Title"] = "Каталог";
}

<!-- CATEGORY STRIP -->
<div class="category-strip">
    @foreach (var category in Model.Categories) {
        var isActive = Model.SelectedCategoryId == category.Id;
        <a asp-controller="Products"
           asp-action="Index"
           asp-route-category="@(isActive ? null : category.Id)"
           asp-route-search="@Model.Search"
           class="category-strip-item @(isActive ? "active" : "")">
            <span style="font-size: 22px;">@category.Icon</span>
            <span>@category.Name</span>
        </a>
    }
</div>
<form asp-controller="Products" asp-action="Index" method="get" id="sortForm" class="sort-form">
    <input type="hidden" name="category" value="@Model.SelectedCategoryId" />
    <input type="hidden" name="search" value="@Model.Search" />
    <input type="hidden" name="minPrice" value="@Model.MinPrice" />
    <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />

    <select name="sortBy" onchange="document.getElementById('sortForm').submit()" class="sort-select">
        <option value="" selected="@(string.IsNullOrEmpty(Model.SortBy))">Сортировать</option>
        <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Сначала дешевле</option>
        <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Сначала дороже</option>
        <option value="name" selected="@(Model.SortBy == "name")">По названию</option>
        <option value="popular" selected="@(Model.SortBy == "popular")">Популярные</option>
    </select>
</form>
<div class="catalog-layout">

    @if (Model.SelectedCategoryId.HasValue) {
        <!-- FILTERS SIDEBAR -->
        <aside class="filters-sidebar">
            <form asp-controller="Products" asp-action="Index" method="get">
                <input type="hidden" name="category" value="@Model.SelectedCategoryId" />
                <input type="hidden" name="search" value="@Model.Search" />
                <input type="hidden" name="sortBy" value="@Model.SortBy" />

                <h3>Цена, AZN</h3>
                <div class="price-filter">
                    <input type="number" name="minPrice" placeholder="От" value="@Model.MinPrice" />
                    <input type="number" name="maxPrice" placeholder="До" value="@Model.MaxPrice" />
                </div>

                @foreach (var specGroup in Model.AvailableSpecFilters) {
                    <h3>@specGroup.Name</h3>
                    <div class="spec-filter-group">
                        @foreach (var value in specGroup.Values) {
                            var specKey = $"{specGroup.Name}:{value}";
                            var isChecked = Model.SelectedSpecs.Contains(specKey);

                            <label class="spec-checkbox">
                                <input type="checkbox" name="specs" value="@specKey" checked="@isChecked" />
                                @value
                            </label>
                        }
                    </div>
                }

                <div class="filter-actions">
                    <button type="submit" class="btn-apply">Применить</button>

                    @{
                        var hasPriceFilter = Model.MinPrice.HasValue || Model.MaxPrice.HasValue;
						var hasSpecFilter = Model.SelectedSpecs.Any();
                    }
                    @if (hasPriceFilter || hasSpecFilter) {
                        <a asp-controller="Products" asp-action="Index"
                           asp-route-category="@Model.SelectedCategoryId"
                           asp-route-search="@Model.Search"
                           class="btn-clear-filters">
                            Очистить
                        </a>
                    }
                    else {
                        <span class="btn-clear-filters disabled">Очистить</span>
                    }
                </div>
            </form>
        </aside>
    }

    <!-- PRODUCTS -->
    <section class="product-list">
        @foreach (var product in Model.Products) {
            <article class="product-card">
                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">
                    <div class="product-image">
                        <img src="@product.ImageUrl" alt="@product.Name">
                    </div>
                    <h3>@product.Name</h3>
                </a>
                @if (product.Specifications.Any()) {
                    <ul class="product-card-specs">
                        @foreach (var spec in product.Specifications.Take(3)) {
                            <li>@spec.Value</li>
                        }
                    </ul>
                }
                <p class="product-price">
                    @product.Price AZN
                </p>
                <button type="button">
                    🛒 Добавить в корзину
                </button>
            </article>
        }
    </section>

</div>

@if (Model.TotalPages > 1) {
    var specsQuery = string.Join("&", Model.SelectedSpecs.Select(s => $"specs={Uri.EscapeDataString(s)}"));

    string PageUrl(int pageNum) => Url.Action("Index", "Products", new {
        category = Model.SelectedCategoryId,
        search = Model.Search,
        minPrice = Model.MinPrice,
        maxPrice = Model.MaxPrice,
        sortBy = Model.SortBy,
        page = pageNum
    }) + (Model.SelectedSpecs.Any() ? "&" + specsQuery : "");

    <div class="pagination">

        <!-- Кнопка "назад" -->
        <a href="@(Model.CurrentPage > 1 ? PageUrl(Model.CurrentPage - 1) : "#")"
           class="page-link @(Model.CurrentPage == 1 ? "disabled" : "")">‹</a>

        @{
            int start = Math.Max(1, Model.CurrentPage - 2);
            int end = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
        }

        @if (start > 1) {
            <a href="@PageUrl(1)" class="page-link">1</a>
            if (start > 2) {
                <span class="page-dots">...</span>
            }
        }

        @for (int i = start; i <= end; i++) {
            <a href="@PageUrl(i)" class="page-link @(i == Model.CurrentPage ? "active" : "")">@i</a>
        }

        @if (end < Model.TotalPages) {
            if (end < Model.TotalPages - 1) {
                <span class="page-dots">...</span>
            }
            <a href="@PageUrl(Model.TotalPages)" class="page-link">@Model.TotalPages</a>
        }

        <!-- Кнопка "вперёд" -->
        <a href="@(Model.CurrentPage<Model.TotalPages? PageUrl(Model.CurrentPage + 1) : "#")"
           class="page-link @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">›</a>

    </div>
}