@model List<AdminUserListItem>
@{
    ViewData["Title"] = Localizer["Users"].Value;
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <h1>@Localizer["Users"]</h1>
</div>

<table class="admin-table">
    <thead>
        <tr>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Email"]</th>
            <th>@Localizer["Role"]</th>
            <th>@Localizer["StatusHeader"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model) {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>
                    <span class="role-badge role-badge-@user.CurrentRole.ToLower()">
                        @user.CurrentRole
                    </span>
                </td>
                <td>
                    @if (user.IsLockedOut) {
                        <span class="order-status order-status-cancelled">@Localizer["Blocked"]</span>
                    }
                    else {
                        <span class="order-status order-status-delivered">@Localizer["Active"]</span>
                    }
                </td>
                <td class="admin-table-actions">
                    <a asp-controller="AdminUsers" asp-action="Details" asp-route-id="@user.Id">
                        ✏️
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>