@model AdminUserListItem
@{
    ViewData["Title"] = Localizer["User"].Value;
    Layout = "_AdminLayout";
}

<div class="admin-page-header details-page-header">
    <h1>@Model.FullName</h1>
</div>

<div class="admin-form-box">
    <div class="order-details-row">
        <span>@Localizer["Email"]:</span>
        <span>@Model.Email</span>
    </div>
    <div class="order-details-row">
        <span>@Localizer["Status"]</span>
        <span>
            @if (Model.IsLockedOut) {
                <span class="order-status order-status-cancelled">@Localizer["Blocked"]</span>
            }
            else {
                <span class="order-status order-status-delivered">@Localizer["Active"]</span>
            }
        </span>
    </div>

    <h3>@Localizer["ChangeRole"]</h3>
    <form asp-controller="AdminUsers" asp-action="ChangeRole" asp-route-id="@Model.Id" method="post" class="order-status-form-row">
        <select name="newRole">
            <option value="User" selected="@(Model.CurrentRole == "User")">User</option>
            <option value="Admin" selected="@(Model.CurrentRole == "Admin")">Admin</option>
        </select>
        <button type="submit" class="btn-admin-primary">@Localizer["SaveRole"]</button>
    </form>

    <h3>@Localizer["Access"]</h3>
    @if (Model.IsLockedOut) {
        <form asp-controller="AdminUsers" asp-action="ToggleLock" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn-admin-primary">@Localizer["Unblock"]</button>
        </form>
    }
    else {
        <form asp-controller="AdminUsers" asp-action="ToggleLock" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('@Localizer["ConfirmBlockUser"]')">
            <button type="submit" class="btn-admin-danger">@Localizer["Block"]</button>
        </form>
    }
</div>