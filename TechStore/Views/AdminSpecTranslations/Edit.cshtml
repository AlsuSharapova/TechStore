@model SpecTranslation
@{
    ViewData["Title"] = Localizer["EditTranslation"].Value;
    Layout = "_AdminLayout";
}

@if (TempData["ErrorMessage"] != null) {
    <div class="admin-alert-error">
        @TempData["ErrorMessage"]
    </div>
}

<div class="admin-page-header">
    <h1>@Localizer["EditTranslation"]</h1>
</div>

<div class="admin-form-box">
    <form asp-controller="AdminSpecTranslations" asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <div class="form-group">
            <label>@Localizer["WordRu"]</label>
            <input name="term" value="@Model.Term" maxlength="200" required />
        </div>

        <div class="form-group">
            <label>EN</label>
            <input name="en" value="@Model.En" required />
        </div>

        <div class="form-group">
            <label>AZ</label>
            <input name="az" value="@Model.Az" required />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-admin-primary">@Localizer["Save"]</button>
            <a asp-controller="AdminSpecTranslations" asp-action="Index" class="btn-admin-secondary">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>