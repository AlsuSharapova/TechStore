@model List<Category>
@{
    ViewData["Title"] = "О нас";
}

<section class="about-hero">
    <div>
        <span class="about-label">О TECHSTORE</span>
        <h1>Техника для работы,<br />учёбы и развлечений.</h1>
        <p>
            TechStore — это интернет-магазин современной техники
            и аксессуаров для тех, кто ценит удобство, качество
            и понятный выбор.
        </p>
    </div>
</section>

<section class="about-story">
    <div class="about-story-content">
        <span class="about-label">НАША ЦЕЛЬ</span>
        <h2>Делаем выбор техники проще</h2>
        <p>
            Мы собрали популярные категории техники в одном месте,
            чтобы не приходилось тратить часы на поиск подходящего товара.
        </p>
        <p>
            В каталоге TechStore вы можете сравнивать характеристики,
            фильтровать товары по параметрам и выбирать подходящий вариант
            в зависимости от ваших задач и бюджета.
        </p>
    </div>

    <div class="about-story-box">
        <span>💻</span>
        <strong>TechStore</strong>
        <p>Современная техника без лишней сложности.</p>
    </div>
</section>

<section class="about-advantages">
    <div class="about-section-header">
        <span class="about-label">ПОЧЕМУ МЫ</span>
        <h2>Всё необходимое — в одном месте</h2>
    </div>

    <div class="about-advantages-list">
        <div class="about-advantage">
            <span>🛍️</span>
            <h3>Удобный каталог</h3>
            <p>
                Категории, фильтры и сортировка помогают быстро
                найти нужный товар.
            </p>
        </div>

        <div class="about-advantage">
            <span>🔍</span>
            <h3>Подробные характеристики</h3>
            <p>
                Сравнивайте основные параметры товаров перед покупкой.
            </p>
        </div>

        <div class="about-advantage">
            <span>🚚</span>
            <h3>Быстрая доставка</h3>
            <p>
                Получайте свои покупки без лишнего ожидания.
            </p>
        </div>

        <div class="about-advantage">
            <span>↩️</span>
            <h3>Удобный возврат</h3>
            <p>
                Возможность вернуть товар в соответствии с условиями магазина.
            </p>
        </div>
    </div>
</section>

<section class="about-categories">
    <div class="about-section-header">
        <span class="about-label">КАТЕГОРИИ</span>
        <h2>Техника под разные задачи</h2>
    </div>

    <div class="about-category-list">
        @foreach(var category in Model)
        {
            <a asp-controller="Products" asp-action="Index" asp-route-category="@category.Id">
                <div class="about-category">
                    <span>@category.Icon</span>
                    <h3>@category.Name</h3>
                </div>
            </a>
        } 
    </div>
</section>

<section class="about-final">
    <h2>Готовы выбрать технику?</h2>
    <p>
        Посмотрите каталог и найдите то, что подходит именно вам.
    </p>

    <a asp-controller="Products" asp-action="Index" class="about-final-btn">
        Перейти в каталог →
    </a>
</section>