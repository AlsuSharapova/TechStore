@model List<Category>
@{
    ViewData["Title"] = Localizer["About"].Value;
}

<section class="about-hero">
    <div>
        <span class="about-label">@Localizer["AboutLabel"]</span>
        <h1>@Localizer["AboutHeroTitle1"]<br />@Localizer["AboutHeroTitle2"]</h1>
        <p>
            @Localizer["AboutHeroText"]
        </p>
    </div>
</section>

<section class="about-story">
    <div class="about-story-content">
        <span class="about-label">@Localizer["OurGoalLabel"]</span>
        <h2>@Localizer["OurGoalTitle"]</h2>
        <p>
            @Localizer["OurGoalText1"]
        </p>
        <p>
            @Localizer["OurGoalText2"]
        </p>
    </div>

    <div class="about-story-box">
        <span>💻</span>
        <strong>TechStore</strong>
        <p>@Localizer["StoryBoxText"]</p>
    </div>
</section>

<section class="about-advantages">
    <div class="about-section-header">
        <span class="about-label">@Localizer["WhyUsLabel"]</span>
        <h2>@Localizer["WhyUsTitle"]</h2>
    </div>

    <div class="about-advantages-list">
        <div class="about-advantage">
            <span>🛍️</span>
            <h3>@Localizer["ConvenientCatalog"]</h3>
            <p>
                @Localizer["ConvenientCatalogText"]
            </p>
        </div>

        <div class="about-advantage">
            <span>🔍</span>
            <h3>@Localizer["DetailedSpecs"]</h3>
            <p>
                @Localizer["DetailedSpecsText"]
            </p>
        </div>

        <div class="about-advantage">
            <span>🚚</span>
            <h3>@Localizer["FastDelivery"]</h3>
            <p>
                @Localizer["AboutFastDeliveryText"]
            </p>
        </div>

        <div class="about-advantage">
            <span>↩️</span>
            <h3>@Localizer["ConvenientReturns"]</h3>
            <p>
                @Localizer["ConvenientReturnsText"]
            </p>
        </div>
    </div>
</section>

<section class="about-categories">
    <div class="about-section-header">
        <span class="about-label">@Localizer["CategoriesLabel"]</span>
        <h2>@Localizer["CategoriesTitle"]</h2>
    </div>

    <div class="about-category-list">
        @foreach (var category in Model) {
            <a asp-controller="Products" asp-action="Index" asp-route-category="@category.Id">
                <div class="about-category">
                    <span>@category.Icon</span>
                    <h3>@category.GetName()</h3>
                </div>
            </a>
        }
    </div>
</section>

<section class="about-final">
    <h2>@Localizer["ReadyToChoose"]</h2>
    <p>
        @Localizer["ReadyToChooseText"]
    </p>

    <a asp-controller="Products" asp-action="Index" class="about-final-btn">
        @Localizer["GoToCatalog"]
    </a>
</section>