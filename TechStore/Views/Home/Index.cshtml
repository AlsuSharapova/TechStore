@model HomeViewModel
@{
    ViewData["Title"] = "Home Page";
}
<section class="hero">
    <div class="hero-content">
        <h1>Новая техника для твоего компьютера</h1>
        <p>
            Мощные ноутбуки, компьютеры и аксессуары
            для работы и развлечений.
        </p>
        <a asp-controller="Products" asp-action="Index" class="btn">
            Смотреть товары →
        </a>
    </div>
    <div class="hero-carousel">
        <div class="carousel-track">

            <div class="carousel-slide">
                <img src="/images/products/product1.jpg" alt="Ноутбук">
            </div>

            <div class="carousel-slide">
                <img src="/images/products/5b6cf361-085c-41c5-90d7-9011f2ac86c8.webp" alt="Телефон">
            </div>

            <div class="carousel-slide">
                <img src="/images/products/no-image.png" alt="Наушники">
            </div>

        </div>

        <button type="button" class="carousel-btn carousel-prev">‹</button>
        <button type="button" class="carousel-btn carousel-next">›</button>

        <div class="carousel-dots">
            <span class="carousel-dot active"></span>
            <span class="carousel-dot"></span>
            <span class="carousel-dot"></span>
        </div>
    </div>
</section>
<!-- CATEGORIES -->
<section class="categories">
    <h2>Популярные категории</h2>
    <div class="category-list">
        @foreach (var category in Model.Categories) {
            <a asp-controller="Products" asp-action="Index" asp-route-category="@category.Id" class="category-card">
                <div class="category-icon">@category.Icon</div>
                <h3>@category.Name</h3>
            </a>
        }
    </div>
</section>
<!-- POPULAR PRODUCTS -->
<section class="popular-products">
    <div class="section-header">
        <h2>Популярные товары</h2>
        <a asp-controller="Products" asp-action="Index">
            Все товары →
        </a>
    </div>
    <div class="product-list">
        @foreach (var product in Model.BestSellers) {
            <article class="product-card">
                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">
                    <div class="product-image">
                        <img src="@product.ImageUrl" alt="@product.Name">
                    </div>
                    <h3>@product.Name</h3>
                </a>
                @if (product.Specifications.Any()) {
                    <ul class="product-card-specs">
                        @foreach (var spec in product.Specifications.Take(3)) {
                            <li>@spec.Value</li>
                        }
                    </ul>
                }
                <p class="product-price">
                    @product.Price AZN
                </p>
                <form asp-controller="Cart" asp-action="Add" method="post">
                    <input type="hidden" name="productId" value="@product.Id" />
                    <button type="submit">🛒 Добавить в корзину</button>
                </form>
            </article>
        }
    </div>
</section>
<!-- WHY TECHSTORE -->
<section class="advantages">
    <h2>Почему TechStore?</h2>
    <div class="advantages-list">
        <div class="advantage">
            <span>🚚</span>
            <h3>Быстрая доставка</h3>
            <p>Доставим ваш заказ в кратчайшие сроки.</p>
        </div>
        <div class="advantage">
            <span>🔒</span>
            <h3>Безопасная оплата</h3>
            <p>Безопасная обработка платежей.</p>
        </div>
        <div class="advantage">
            <span>↩️</span>
            <h3>Возврат</h3>
            <p>Возможность вернуть товар.</p>
        </div>
    </div>
</section>

<script>
    const track = document.querySelector('.carousel-track');
    const slides = document.querySelectorAll('.carousel-slide');
    const dots = document.querySelectorAll('.carousel-dot');

    let currentSlide = 0;
    let timer;

    function showSlide(index) {
        currentSlide = index;

        track.style.transform = `translateX(-${currentSlide * 100}%)`;

        dots.forEach(dot => dot.classList.remove('active'));
        dots[currentSlide].classList.add('active');

        // Сбрасываем таймер
        clearTimeout(timer);

        // Запускаем заново
        timer = setTimeout(() => {
            const nextSlide = (currentSlide + 1) % slides.length;
            showSlide(nextSlide);
        }, 3000);
    }

    document.querySelector('.carousel-next').addEventListener('click', () => {
        const nextSlide = (currentSlide + 1) % slides.length;
        showSlide(nextSlide);
    });

    document.querySelector('.carousel-prev').addEventListener('click', () => {
        const previousSlide =
            (currentSlide - 1 + slides.length) % slides.length;

        showSlide(previousSlide);
    });

    // Первый таймер
    timer = setTimeout(() => {
        showSlide(1);
    }, 3000);
</script>