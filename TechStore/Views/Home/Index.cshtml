@model HomeViewModel
@{
    ViewData["Title"] = Localizer["HomePage"].Value;
}
<section class="hero">
    <div class="hero-content">
        <h1>@Localizer["HeroTitle"]</h1>
        <p>
            @Localizer["HeroText"]
        </p>
        <a asp-controller="Products" asp-action="Index" class="btn">
            @Localizer["ViewProducts"]
        </a>
    </div>
    <div class="hero-carousel">
        <div class="carousel-track">

            <div class="carousel-slide">
                <img src="/images/products/product1.jpg" alt="@Localizer["CarouselLaptop"]">
            </div>

            <div class="carousel-slide">
                <img src="/images/products/5b6cf361-085c-41c5-90d7-9011f2ac86c8.webp" alt="@Localizer["CarouselPhone"]">
            </div>

            <div class="carousel-slide">
                <img src="/images/products/no-image.png" alt="@Localizer["CarouselHeadphones"]">
            </div>

        </div>

        <button type="button" class="carousel-btn carousel-prev">‹</button>
        <button type="button" class="carousel-btn carousel-next">›</button>

        <div class="carousel-dots">
            <span class="carousel-dot active"></span>
            <span class="carousel-dot"></span>
            <span class="carousel-dot"></span>
        </div>
    </div>
</section>
<!-- CATEGORIES -->
<section class="categories">
    <h2>@Localizer["PopularCategories"]</h2>
    <div class="category-list">
        @foreach (var category in Model.Categories) {
            <a asp-controller="Products" asp-action="Index" asp-route-category="@category.Id" class="category-card">
                <div class="category-icon">@category.Icon</div>
                <h3>@category.GetName()</h3>
            </a>
        }
    </div>
</section>
<!-- POPULAR PRODUCTS -->
<section class="popular-products">
    <div class="section-header">
        <h2>@Localizer["PopularProducts"]</h2>
        <a asp-controller="Products" asp-action="Index">
            @Localizer["AllProducts"]
        </a>
    </div>
    <div class="product-list">
        @foreach (var product in Model.BestSellers) {
            <article class="product-card">
                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">
                    <div class="product-image">
                        <img src="@product.ImageUrl" alt="@product.Name">
                    </div>
                    <h3>@product.Name</h3>
                </a>
                @if (product.Specifications.Any()) {
                    <ul class="product-card-specs">
                        @foreach (var spec in product.Specifications.Take(3)) {
                            <li>
                                <strong>@SpecTranslator.Translate(spec.Name):</strong> @SpecTranslator.Translate(spec.Value)
                            </li>
                        }
                    </ul>
                }
                <p class="product-price">
                    @product.Price AZN
                </p>
                <form asp-controller="Cart" asp-action="Add" method="post">
                    <input type="hidden" name="productId" value="@product.Id" />
                    <button type="submit">🛒 @Localizer["AddToCart"]</button>
                </form>
            </article>
        }
    </div>
</section>
<!-- WHY TECHSTORE -->
<section class="advantages">
    <h2>@Localizer["WhyTechStore"]</h2>
    <div class="advantages-list">
        <div class="advantage">
            <span>🚚</span>
            <h3>@Localizer["FastDelivery"]</h3>
            <p>@Localizer["FastDeliveryText"]</p>
        </div>
        <div class="advantage">
            <span>🔒</span>
            <h3>@Localizer["SecurePayment"]</h3>
            <p>@Localizer["SecurePaymentText"]</p>
        </div>
        <div class="advantage">
            <span>↩️</span>
            <h3>@Localizer["Returns"]</h3>
            <p>@Localizer["ReturnsText"]</p>
        </div>
    </div>
</section>

<script>
    const track = document.querySelector('.carousel-track');
    const slides = document.querySelectorAll('.carousel-slide');
    const dots = document.querySelectorAll('.carousel-dot');

    let currentSlide = 0;
    let timer;

    function showSlide(index) {
        currentSlide = index;

        track.style.transform = `translateX(-${currentSlide * 100}%)`;

        dots.forEach(dot => dot.classList.remove('active'));
        dots[currentSlide].classList.add('active');

        // Сбрасываем таймер
        clearTimeout(timer);

        // Запускаем заново
        timer = setTimeout(() => {
            const nextSlide = (currentSlide + 1) % slides.length;
            showSlide(nextSlide);
        }, 3000);
    }

    document.querySelector('.carousel-next').addEventListener('click', () => {
        const nextSlide = (currentSlide + 1) % slides.length;
        showSlide(nextSlide);
    });

    document.querySelector('.carousel-prev').addEventListener('click', () => {
        const previousSlide =
            (currentSlide - 1 + slides.length) % slides.length;

        showSlide(previousSlide);
    });

    // Первый таймер
    timer = setTimeout(() => {
        showSlide(1);
    }, 3000);
</script>