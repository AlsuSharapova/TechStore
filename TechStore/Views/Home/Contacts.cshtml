@model StoreSettings
@{
    ViewData["Title"] = Localizer["Contacts"].Value;
}

<section class="contacts-hero">
    <h1>@Localizer["ContactUs"]</h1>
    <p>
        @Localizer["ContactsHeroText"]
    </p>
</section>

<section class="contacts-layout">

    <div class="contacts-info">
        <div class="contact-card">
            <span class="contact-icon">📍</span>
            <div>
                <h3>@Localizer["Address"]</h3>
                <p>@Model.Address</p>
            </div>
        </div>

        <div class="contact-card">
            <span class="contact-icon">☎️</span>
            <div>
                <h3>@Localizer["ContactPhone"]</h3>
                <p>@Model.Phone</p>
            </div>
        </div>

        <div class="contact-card">
            <span class="contact-icon">✉️</span>
            <div>
                <h3>@Localizer["Email"]</h3>
                <p>@Model.Email</p>
            </div>
        </div>

        <div class="contact-card">
            <span class="contact-icon">🕐</span>
            <div>
                <h3>@Localizer["WorkingHoursTitle"]</h3>
                <p>@Model.WorkingHours</p>
                <p>@Model.SundayHours</p>
            </div>
        </div>
    </div>

    <div class="contacts-map">
        <div id="map"></div>
    </div>

</section>

<section class="contact-form-section">

    <div class="about-section-header">
        <span class="about-label">@Localizer["FeedbackLabel"]</span>
        <h2>@Localizer["HaveQuestions"]</h2>
    </div>

    <form class="contact-form">

        <div class="contact-form-row">
            <div class="form-group">
                <label>@Localizer["Name"]</label>
                <input type="text" placeholder="@Localizer["YourName"]" />
            </div>

            <div class="form-group">
                <label>@Localizer["Email"]</label>
                <input type="email" placeholder="example@mail.com" />
            </div>
        </div>

        <div class="form-group">
            <label>@Localizer["Message"]</label>
            <textarea rows="5" placeholder="@Localizer["YourQuestion"]"></textarea>
        </div>

        <button type="submit" class="contact-submit">
            @Localizer["SendMessage"]
        </button>

    </form>

</section>

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    const map = L.map('map').setView([40.375, 49.832], 15);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    const marker = L.marker([40.375, 49.832]).addTo(map);

    marker.bindPopup(`
        <strong>TechStore</strong><br>
        ул. Низами, 45
    `).openPopup();
</script>