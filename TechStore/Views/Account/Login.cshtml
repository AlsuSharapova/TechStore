@model LoginViewModel
@{
    ViewData["Title"] = Localizer["LoginTitle"].Value;
}

<div class="account-container">
    <div class="account-box">
        <h2>@Localizer["LoginTitle"]</h2>

        @if (TempData["Message"] != null) {
            <div class="alert-success">
                @TempData["Message"]
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Email">@Localizer["Email"]</label>
                <input asp-for="Email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">@Localizer["Password"]</label>
                <input asp-for="Password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="login-options">
                <div class="form-check">
                    <label>
                        <input asp-for="RememberMe" />
                        @Localizer["RememberMe"]
                    </label>
                </div>

                <div class="forgot-password">
                    <a asp-controller="Account" asp-action="VerifyEmail">
                        @Localizer["ForgotPassword"]
                    </a>
                </div>
            </div>

            <button type="submit" class="btn-account">@Localizer["Login"]</button>

            <p class="account-switch">
                @Localizer["NoAccount"] <a asp-controller="Account" asp-action="Register">@Localizer["RegisterButton"]</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}