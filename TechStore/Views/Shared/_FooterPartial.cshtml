<footer>
    <div class="footer-content">
        <div class="footer-brand">
            <h3>TECHSTORE</h3>
            <p>@Localizer["StoreDescription"]</p>
        </div>
        <div class="footer-column">
            <h4>@Localizer["ForCustomers"]</h4>
            <a asp-controller="Products" asp-action="Index">@Localizer["Catalog"]</a>
            <a asp-controller="Orders" asp-action="Index">@Localizer["MyOrders"]</a>
            <a asp-controller="Cart" asp-action="Index">@Localizer["Cart"]</a>
        </div>
        <div class="footer-column">
            <h4>@Localizer["Help"]</h4>
            <a asp-controller="Home" asp-action="Delivery">@Localizer["Delivery"]</a>
            <a asp-controller="Home" asp-action="Payment">@Localizer["Payment"]</a>
            <a asp-controller="Home" asp-action="Returns">@Localizer["Returns"]</a>
            <a asp-controller="Home" asp-action="Contacts">@Localizer["Contacts"]</a>
        </div>
    </div>
    <div class="footer-bottom">
        <p>© 2026 TechStore</p>
        <div>
            <a href="#">Instagram</a>
            <a href="#">Telegram</a>
            <a href="#">Facebook</a>
        </div>
    </div>
</footer>