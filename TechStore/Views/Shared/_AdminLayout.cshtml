<!DOCTYPE html>
<html lang="@System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <partial name="_MetaPartial" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
    <title>@ViewData["Title"] - @Localizer["AdminTitle"]</title>
</head>
<body class="admin-body">

    <div class="admin-layout">

        <aside class="admin-sidebar">
            <div class="admin-logo">TECHSTORE</div>

            <nav class="admin-nav">
                @{
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                }

                <a asp-controller="Admin" asp-action="Index"
                   class="admin-nav-link @(currentController == "Admin" ? "active" : "")">
                    📊 @Localizer["Dashboard"]
                </a>
                <a asp-controller="AdminProducts" asp-action="Index"
                   class="admin-nav-link @(currentController == "AdminProducts" ? "active" : "")">
                    📦 @Localizer["Products"]
                </a>
                <a asp-controller="AdminCategories" asp-action="Index"
                   class="admin-nav-link @(currentController == "AdminCategories" ? "active" : "")">
                    🗂 @Localizer["Categories"]
                </a>
                <a asp-controller="AdminOrders" asp-action="Index"
                   class="admin-nav-link @(currentController == "AdminOrders" ? "active" : "")">
                    🧾 @Localizer["Orders"]
                </a>
                <a asp-controller="AdminUsers" asp-action="Index"
                   class="admin-nav-link @(currentController == "AdminUsers" ? "active" : "")">
                    👥 @Localizer["Users"]
                </a>
            </nav>

            <div class="admin-sidebar-footer">
                <a asp-controller="Home" asp-action="Index" class="admin-nav-link">
                    ← @Localizer["BackToSite"]
                </a>
            </div>
        </aside>

        <main class="admin-content">
            @RenderBody()
        </main>

    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>