
<header>
    <div class="header-top">
        <a asp-controller="Home" asp-action="Index" class="logo">TECHSTORE</a>
        <nav>
            <a asp-controller="Products" asp-action="Index">Каталог</a>
            <a asp-controller="Home" asp-action="About">О нас</a>
            <a asp-controller="Home" asp-action="Contacts">Контакты</a>
        </nav>
        <div class="header-actions">
            <select>
                <option>RU</option>
                <option>EN</option>
                <option>AZ</option>
            </select>
            <a asp-controller="Cart" asp-action="Index" class="header-icon">
                🛒
            </a>
            @if (User.Identity?.IsAuthenticated == true) {
                <div class="account-menu">
                    <button type="button" class="account-link">
                        <span class="account-icon">👤</span>
                        @User.FindFirst("FullName")?.Value
                    </button>
                    <div class="account-dropdown">
                        <a asp-controller="Account" asp-action="Profile">
                            👤 Мой профиль
                        </a>
                        <a asp-controller="Orders" asp-action="Index">
                            📦 Мои заказы
                        </a>
                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">
                            <button type="submit">
                                🚪 Выйти
                            </button>
                        </form>
                    </div>
                </div>
            }
            else {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="account-link">
                    👤 Войти
                </a>
            }
        </div>
    </div>
    <!-- SEARCH -->
    <div class="search-container">
        <form asp-controller="Products" asp-action="Index" method="get">
            <input type="hidden" name="category" value="@Context.Request.Query["category"]" />
            <input type="hidden" name="minPrice" value="@Context.Request.Query["minPrice"]" />
            <input type="hidden" name="maxPrice" value="@Context.Request.Query["maxPrice"]" />


            <input type="text"
                   name="search"
                   value="@Context.Request.Query["search"]"
                   placeholder="Поиск товаров...">
            <button type="submit">🔍</button>
        </form>
    </div>
</header>