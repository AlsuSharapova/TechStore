<header>
    <div class="header-top">
        <a asp-controller="Home" asp-action="Index" class="logo">TECHSTORE</a>
        <nav>
            <a asp-controller="Products" asp-action="Index">@Localizer["Catalog"]</a>
            <a asp-controller="Home" asp-action="About">@Localizer["About"]</a>
            <a asp-controller="Home" asp-action="Contacts">@Localizer["Contacts"]</a>
        </nav>
        <div class="header-actions">
            <form asp-controller="Language" asp-action="SetLanguage" method="post" class="language-form">
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <select name="culture" onchange="this.form.submit()">
                    <option value="en" selected="@(System.Threading.Thread.CurrentThread.CurrentUICulture.Name == "en")">EN</option>
                    <option value="ru" selected="@(System.Threading.Thread.CurrentThread.CurrentUICulture.Name == "ru")">RU</option>
                    <option value="az" selected="@(System.Threading.Thread.CurrentThread.CurrentUICulture.Name == "az")">AZ</option>
                </select>
            </form>
            <a asp-controller="Cart" asp-action="Index" class="header-icon">
                🛒
            </a>
            @if (User.Identity?.IsAuthenticated == true) {
                <div class="account-menu">
                    <button type="button" class="account-link">
                        <span class="account-icon">👤</span>
                        @User.FindFirst("FullName")?.Value
                    </button>
                    <div class="account-dropdown">
                        @if (User.IsInRole("Admin")) {
                            <a asp-controller="Admin" asp-action="Index">
                                🛠 @Localizer["AdminPanel"]
                            </a>
                        }
                        <a asp-controller="Account" asp-action="Profile">
                            👤 @Localizer["MyProfile"]
                        </a>
                        <a asp-controller="Orders" asp-action="Index">
                            📦 @Localizer["MyOrders"]
                        </a>
                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">
                            <button type="submit">
                                🚪 @Localizer["Logout"]
                            </button>
                        </form>
                    </div>
                </div>
            }
            else {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="account-link">
                    👤 @Localizer["Login"]
                </a>
            }
        </div>
    </div>
    <!-- SEARCH -->
    <div class="search-container">
        <form asp-controller="Products" asp-action="Index" method="get">
            <input type="hidden" name="category" value="@Context.Request.Query["category"]" />
            <input type="hidden" name="minPrice" value="@Context.Request.Query["minPrice"]" />
            <input type="hidden" name="maxPrice" value="@Context.Request.Query["maxPrice"]" />


            <input type="text"
                   name="search"
                   value="@Context.Request.Query["search"]"
                   placeholder="@Localizer["SearchProducts"]">
            <button type="submit">🔍</button>
        </form>
    </div>
</header>