<form asp-controller="Language" asp-action="SetLanguage" method="post" class="language-form">
    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
    <select name="culture" onchange="this.form.submit()">
        <option value="en" selected="@(System.Threading.Thread.CurrentThread.CurrentUICulture.Name == "en")">EN</option>
        <option value="ru" selected="@(System.Threading.Thread.CurrentThread.CurrentUICulture.Name == "ru")">RU</option>
        <option value="az" selected="@(System.Threading.Thread.CurrentThread.CurrentUICulture.Name == "az")">AZ</option>
    </select>
</form>