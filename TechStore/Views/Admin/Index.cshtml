@model DashboardViewModel
@{
    ViewData["Title"] = Localizer["Dashboard"].Value;
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <h1>@Localizer["Dashboard"]</h1>
</div>

<div class="dashboard-stats">
    <a asp-controller="AdminProducts" asp-action="Index" class="stat-card">
        <span class="stat-icon">📦</span>
        <div>
            <div class="stat-value">@Model.TotalProducts</div>
            <div class="stat-label">@Localizer["ProductsCount"]</div>
        </div>
    </a>

    <a asp-controller="AdminCategories" asp-action="Index" class="stat-card">
        <span class="stat-icon">🗂</span>
        <div>
            <div class="stat-value">@Model.TotalCategories</div>
            <div class="stat-label">@Localizer["CategoriesCount"]</div>
        </div>
    </a>

    <a asp-controller="AdminUsers" asp-action="Index" class="stat-card">
        <span class="stat-icon">👥</span>
        <div>
            <div class="stat-value">@Model.TotalUsers</div>
            <div class="stat-label">@Localizer["UsersCount"]</div>
        </div>
    </a>

    <a asp-controller="AdminOrders" asp-action="Index" class="stat-card">
        <span class="stat-icon">🧾</span>
        <div>
            <div class="stat-value">@Model.TotalOrders</div>
            <div class="stat-label">@Localizer["OrdersCount"]</div>
        </div>
    </a>

    <a asp-controller="AdminOrders" asp-action="Index" class="stat-card stat-card-highlight">
        <span class="stat-icon">💰</span>
        <div>
            <div class="stat-value">@Model.TotalRevenue AZN</div>
            <div class="stat-label">@Localizer["Revenue"]</div>
        </div>
    </a>
</div>

<h3>@Localizer["RecentOrders"]</h3>

@if (!Model.RecentOrders.Any()) {
    <p class="no-orders-text">@Localizer["NoOrdersYet"]</p>
}
else {
    <table class="admin-table">
        <thead>
            <tr>
                <th>№</th>
                <th>@Localizer["Customer"]</th>
                <th>@Localizer["DateHeader"]</th>
                <th>@Localizer["AmountHeader"]</th>
                <th>@Localizer["StatusHeader"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.RecentOrders) {
                <tr>
                    <td>#@order.Id</td>
                    <td>@order.User.FullName</td>
                    <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@order.TotalPrice AZN</td>
                    <td>
                        <span class="order-status order-status-@order.Status.ToString().ToLower()">
                            @Localizer["OrderStatus_" + order.Status]
                        </span>
                    </td>
                    <td class="admin-table-actions">
                        <a asp-controller="AdminOrders" asp-action="Details" asp-route-id="@order.Id">
                            👁
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}