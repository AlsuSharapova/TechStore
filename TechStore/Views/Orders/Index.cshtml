@model List<Order>
@{
    ViewData["Title"] = "Мои заказы";
}

<h1>Мои заказы</h1>

@if (!Model.Any()) {
    <div class="cart-empty">
        <p>У вас пока нет заказов.</p>
        <a asp-controller="Products" asp-action="Index" class="btn-account-outline">
            Перейти в каталог
        </a>
    </div>
}
else {
    <div class="orders-list">
        @foreach (var order in Model) {
            <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="order-card">
                <div class="order-card-header">
                    <span class="order-number">Заказ №@order.Id</span>
                    <span class="order-status order-status-@order.Status.ToString().ToLower()">
                        @order.Status
                    </span>
                </div>
                <div class="order-card-body">
                    <span>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                    <span>@order.Items.Count товар(ов)</span>
                    <span class="order-card-total">@order.TotalPrice AZN</span>
                </div>
            </a>
        }
    </div>
}