@model ProductFormViewModel
@{
    ViewData["Title"] = Localizer["EditProduct"].Value;
    Layout = "_AdminLayout";
}

<div class="admin-page-header details-page-header">
    <h1>@Localizer["EditProduct"]</h1>
</div>

<div class="admin-form-box">
    <form asp-controller="AdminProducts" asp-action="Edit" asp-route-id="@ViewBag.ProductId" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <partial name="_ProductFormFields" model="Model" />

        <div class="form-group">
            <label>@Localizer["CurrentImage"]</label>
            <img src="@ViewBag.CurrentImageUrl" alt="@Localizer["CurrentImage"]" class="admin-current-image" />
        </div>

        <div class="form-group">
            <label asp-for="ImageFile">@Localizer["ReplaceImage"]</label>
            <input asp-for="ImageFile" type="file" accept="image/*" />
        </div>

        <h3>@Localizer["Specifications"]</h3>
        <div id="specsContainer"></div>

        <button type="button" id="addSpecBtn" class="btn-admin-secondary">
            + @Localizer["AddSpecification"]
        </button>

        <div class="spec-suggestions" id="specSuggestions"></div>

        <div class="form-actions">
            <button type="submit" class="btn-admin-primary">@Localizer["SaveChanges"]</button>
            <a asp-controller="AdminProducts" asp-action="Index" class="btn-admin-secondary">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const specNamePlaceholder = @Html.Raw(Json.Serialize(Localizer["SpecNamePlaceholder"].Value));
        const specValuePlaceholder = @Html.Raw(Json.Serialize(Localizer["SpecValuePlaceholder"].Value));

        const specSuggestionsByCategory = {
            "Ноутбуки": ["Процессор", "Видеокарта", "Оперативная память", "Накопитель"],
            "Компьютеры": ["Процессор", "Видеокарта", "Оперативная память", "Накопитель"],
            "Телефоны": ["Память", "Основная камера", "Фронтальная камера", "Связь"],
            "Наушники": ["Тип подключения", "Время работы", "Частотный диапазон", "Шумоподавление"],
            "Мышки": ["DPI", "Тип подключения", "Количество кнопок"]
        };

        const specsContainer = document.getElementById('specsContainer');
        const addSpecBtn = document.getElementById('addSpecBtn');
        const categorySelect = document.getElementById('categorySelect');
        const specSuggestionsDiv = document.getElementById('specSuggestions');

        function addSpecRow(name = '', value = '') {
            const row = document.createElement('div');
            row.className = 'spec-row';
            row.innerHTML = `
                <input type="text" name="SpecNames" placeholder="${specNamePlaceholder}" value="${name}" />
                <input type="text" name="SpecValues" placeholder="${specValuePlaceholder}" value="${value}" />
                <button type="button" class="spec-remove-btn">✕</button>
            `;
            row.querySelector('.spec-remove-btn').addEventListener('click', () => row.remove());
            specsContainer.appendChild(row);
        }

        addSpecBtn.addEventListener('click', () => addSpecRow());

        categorySelect.addEventListener('change', () => {
            const categoryName = categorySelect.options[categorySelect.selectedIndex].text;
            const suggestions = specSuggestionsByCategory[categoryName] || [];

            specSuggestionsDiv.innerHTML = '';
            suggestions.forEach(specName => {
                const chip = document.createElement('button');
                chip.type = 'button';
                chip.className = 'spec-chip';
                chip.textContent = specName;
                chip.addEventListener('click', () => addSpecRow(specName));
                specSuggestionsDiv.appendChild(chip);
            });
        });

        // Заполняем существующими характеристиками при загрузке
        const existingNames = @Html.Raw(Json.Serialize(Model.SpecNames));
        const existingValues = @Html.Raw(Json.Serialize(Model.SpecValues));

        if (existingNames.length > 0)
        {
            for (let i = 0; i < existingNames.length; i++)
            {
                addSpecRow(existingNames[i], existingValues[i]);
            }
        }
        else
        {
            addSpecRow();
        }
    </script>
}