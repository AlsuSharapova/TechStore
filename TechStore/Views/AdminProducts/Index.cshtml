@model List<Product>
@{
    ViewData["Title"] = Localizer["Products"].Value;
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <h1>@Localizer["Products"]</h1>
    <a asp-controller="AdminProducts" asp-action="Create" class="btn-admin-primary">
        + @Localizer["AddProduct"]
    </a>
</div>

<table class="admin-table">
    <thead>
        <tr>
            <th>@Localizer["Photo"]</th>
            <th>@Localizer["ProductName"]</th>
            <th>@Localizer["Category"]</th>
            <th>@Localizer["PriceHeader"]</th>
            <th>@Localizer["Stock"]</th>
            <th>@Localizer["Bestseller"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model) {
            <tr>
                <td>
                    <img src="@product.ImageUrl" alt="@product.Name" class="admin-table-image" />
                </td>
                <td>@product.Name</td>
                <td>@product.Category.GetName()</td>
                <td>@product.Price AZN</td>
                <td>@product.StockQuantity</td>
                <td>@(product.IsBestSeller? Localizer["Yes"].Value : "—")</td>
                <td class="admin-table-actions">
                    <a asp-controller="AdminProducts" asp-action="Edit" asp-route-id="@product.Id">
                        ✏️
                    </a>
                    <form asp-controller="AdminProducts" asp-action="Delete" asp-route-id="@product.Id" method="post"
                          onsubmit="return confirm('@Localizer["ConfirmDeleteProduct", product.Name]')" class="delete-form">
                        <button type="submit">🗑</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>