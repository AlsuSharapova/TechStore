@model ProductFormViewModel

<div class="form-group">
    <label asp-for="Name">@Localizer["ProductName"]</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name" class="field-error"></span>
</div>

<div class="form-group">
    <label asp-for="Description">@Localizer["Description"]</label>
    <textarea asp-for="Description" rows="4"></textarea>
    <span asp-validation-for="Description" class="field-error"></span>
</div>

<div class="form-group">
    <label asp-for="DescriptionEn">@Localizer["Description"] (EN)</label>
    <textarea asp-for="DescriptionEn" rows="4"></textarea>
    <span asp-validation-for="DescriptionEn" class="field-error"></span>
</div>

<div class="form-group">
    <label asp-for="DescriptionAz">@Localizer["Description"] (AZ)</label>
    <textarea asp-for="DescriptionAz" rows="4"></textarea>
    <span asp-validation-for="DescriptionAz" class="field-error"></span>
</div>

<div class="form-row">
    <div class="form-group">
        <label asp-for="Price">@Localizer["Price"]</label>
        <input asp-for="Price" type="number" step="0.01" />
        <span asp-validation-for="Price" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="StockQuantity">@Localizer["Stock"]</label>
        <input asp-for="StockQuantity" type="number" />
        <span asp-validation-for="StockQuantity" class="field-error"></span>
    </div>
</div>

<div class="form-group">
    <label asp-for="CategoryId">@Localizer["Category"]</label>
    <select asp-for="CategoryId" id="categorySelect">
        <option value="">@Localizer["SelectCategory"]</option>
        @foreach (var category in (List<Category>)ViewBag.Categories) {
            <option value="@category.Id">@category.Name</option>
        }
    </select>
    <span asp-validation-for="CategoryId" class="field-error"></span>
</div>

<div class="best-seller-check">
    <input asp-for="IsBestSeller" />
    <label asp-for="IsBestSeller">
        @Localizer["Bestseller"]
    </label>
    <span>@Localizer["ShowOnHome"]</span>
</div>