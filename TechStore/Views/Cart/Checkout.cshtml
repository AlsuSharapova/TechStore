@model CheckoutViewModel
@{
    ViewData["Title"] = Localizer["CheckoutTitle"].Value;
}

<h1>@Localizer["CheckoutTitle"]</h1>

<div class="checkout-layout">

    <form asp-controller="Cart" asp-action="Checkout" method="post" class="checkout-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="DeliveryAddress">@Localizer["DeliveryAddressField"]</label>
            <input asp-for="DeliveryAddress" placeholder="@Localizer["AddressPlaceholder"]" />
            <span asp-validation-for="DeliveryAddress" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="PhoneNumber">@Localizer["PhoneField"]</label>
            <input asp-for="PhoneNumber" placeholder="+994 XX XXX XX XX" />
            <span asp-validation-for="PhoneNumber" class="field-error"></span>
        </div>

        <button type="submit" class="btn-account">@Localizer["ConfirmOrder"]</button>
    </form>

    <div class="checkout-summary">
        <h3>@Localizer["YourOrder"]</h3>

        @foreach (var item in Model.Cart!.Items) {
            <div class="checkout-summary-item">
                <span>@item.Product.Name × @item.Quantity</span>
                <span>@(item.Product.Price* item.Quantity) AZN</span>
            </div>
        }

        <div class="checkout-summary-total">
            <span>@Localizer["Total"]</span>
            <span>@Model.Cart.Items.Sum(i => i.Product.Price * i.Quantity) AZN</span>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}